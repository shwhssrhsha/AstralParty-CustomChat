<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>QuickChatToolbox</AssemblyName>
    <RootNamespace>QuickChatToolbox</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>CS0618;CS0612</NoWarn>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CesiumLoader.SDK">
      <HintPath>..\..\refs\CesiumLoader.SDK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AstralParty.Runtime">
      <HintPath>..\..\refs\AstralParty.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\refs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>..\..\refs\UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Google.Protobuf.Runtime">
      <HintPath>..\..\refs\Google.Protobuf.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
